    {
      "id": "salon.enter",
      "speaker": "narrator",
      "text": "The salon is a carefully engineered accident of proximity: policy, money, and people who can afford to look bored. Maris Quell stands near a tall window, glass half-full, expression half-elsewhere.",
      "tags": [
        "salon",
        "arrival"
      ],
      "conditions": [],
      "effects": [
        {
          "op": "location",
          "id": "salon"
        }
      ],
      "choices": [
        {
          "id": "salon.enter.approach",
          "text": "Approach Maris before your faculties form a committee.",
          "intent": "direct",
          "next": "salon.intro_awkward",
          "effects": []
        },
        {
          "id": "salon.enter.taly_first",
          "text": "The woman beside her is already measuring you. Address that.",
          "intent": "cautious",
          "next": "salon.taly_intercept",
          "effects": []
        }
      ],
      "next": null,
      "faculty_interjections": [
        {
          "faculty": "Analysis",
          "text": "Window exit, two conversational clusters, one dead zone by the ferns. Ferns are always guilty.",
          "weight": 1
        },
        {
          "faculty": "Insecurity",
          "text": "She has seen you. Or she is looking at the window. Or both. Both is worse.",
          "weight": 1
        }
      ]
    },
    {
      "id": "salon.genuine_deflect",
      "speaker": "maris_quell",
      "text": "Logistics as moral philosophy. Cute armor. Keep it if you need it \u2014 just know I can see the hinges.",
