    {
      "id": "salon.enter",
      "speaker": "narrator",
      "text": "Salon: policy and money arranged to look accidental. Maris Quell at the window, mid-thought \u2014 the look of someone rewriting an argument she will have after the toast. Taly Renn at her shoulder, already bored by you.",
      "tags": [
        "salon",
        "arrival"
      ],
      "conditions": [],
      "effects": [
        {
          "op": "location",
          "id": "salon"
        }
      ],
      "choices": [
        {
          "id": "salon.enter.approach",
          "text": "Interrupt the argument in her head.",
          "intent": "direct",
          "next": "salon.intro_awkward"
        },
        {
          "id": "salon.enter.taly_first",
          "text": "The friend is the gate. Address the gate.",
