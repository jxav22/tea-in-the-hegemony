{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tea://schemas/dialogue_node",
  "title": "DialogueNode",
  "type": "object",
  "required": ["id", "text"],
  "properties": {
    "id": { "type": "string" },
    "speaker": { "type": "string" },
    "text": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "effects": {
      "type": "array",
      "items": { "$ref": "#/$defs/effect" }
    },
    "choices": {
      "type": "array",
      "items": { "$ref": "#/$defs/choice" }
    },
    "next": { "type": ["string", "null"] },
    "faculty_interjections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["faculty", "text"],
        "properties": {
          "faculty": {
            "type": "string",
            "enum": ["Analysis", "Tradecraft", "Composure", "Empathy", "Improvisation", "Idealism", "Insecurity"]
          },
          "text": { "type": "string" },
          "weight": { "type": "number" }
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "properties": {
        "flag": { "type": "string" },
        "op": { "type": "string" },
        "value": {},
        "all": { "type": "array" },
        "any": { "type": "array" }
      }
    },
    "effect": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "type": "string",
          "enum": ["set_flag", "add_flag", "toggle_flag", "rel", "memory", "heat", "objective", "item", "beat", "location"]
        },
        "flag": { "type": "string" },
        "value": {},
        "char": { "type": "string" },
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "amount": { "type": "integer" },
        "status": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "choice": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "intent": { "type": "string" },
        "next": { "type": ["string", "null"] },
        "conditions": { "type": "array" },
        "effects": { "type": "array" }
      }
    }
  }
}
