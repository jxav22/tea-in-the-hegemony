      "choices": [],
      "next": null,
      "faculty_interjections": [
        {
          "faculty": "Tradecraft",
          "text": "Fragment lost. Rival scored. Anticipate Wren's clinical disappointment.",
          "weight": 1
        }
      ]
    },
    {
      "id": "ending.human_cost_maris",
      "speaker": "maris_quell",
      "text": "Taly told me. You chose her over a win. I don't need your real name to keep that. Observatory keeps evidence on people under pressure. So do I. Don't ask me to translate it into softness on demand.",
      "tags": [
        "end",
        "ending",
        "maris_quell"
      ],
      "conditions": [],
      "effects": [
        {
          "op": "memory",
          "id": "mem_ending_human",
          "summary": "Lost the fragment to Sera; gained Maris's measured respect.",
          "salience": 7,
          "tags": [
            "ending",
            "maris"
          ]
        },
        {
          "op": "set_flag",
          "flag": "ending_id",
          "value": "human_cost"
        }
      ],
      "choices": [],
      "next": null,
      "faculty_interjections": [
        {
          "faculty": "Idealism",
          "text": "Data she'll keep. That's more than a mission stamp.",
          "weight": 1
        },
        {
          "faculty": "Insecurity",
          "text": "Wren will not keep that data warmly.",
          "weight": 1
        }
      ]
    },
    {
      "id": "ending.professional_win",
      "speaker": "narrator",
      "text": "Fragment. Cover. Toast like metal. Maris does not look for you \u2014 she is correcting a deputy about opacity timelines. You won the evening she was not starring in.",
      "tags": [
        "end",
        "ending",
        "professional"
      ],
      "conditions": [],
      "effects": [
