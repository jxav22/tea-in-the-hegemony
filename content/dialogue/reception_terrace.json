    {
      "id": "ending.balanced",
      "speaker": "narrator",
      "text": "Fragment secured. Taly keeps her career. Maris, after the toast: 'You split the problem without dumping the person. Observatory could use that. Don't turn it into a personality.' She is already walking toward someone else who needs numbers.",
      "tags": [
        "balanced",
        "end",
        "ending"
      ],
      "conditions": [],
      "effects": [
        {
          "op": "set_flag",
          "flag": "chapter_complete",
          "value": true
        },
        {
          "op": "rel",
          "char": "maris_quell",
          "familiarity": 2
        },
        {
          "op": "set_flag",
          "flag": "ending_id",
          "value": "balanced"
        }
      ],
      "choices": [],
      "next": null,
      "faculty_interjections": [
        {
          "faculty": "Empathy",
          "text": "Both ledgers breathing. Rare night.",
          "weight": 1
        },
        {
          "faculty": "Composure",
          "text": "Accept almost-praise without inventing a wedding.",
          "weight": 1
        }
      ]
    },
    {
      "id": "ending.connection",
      "speaker": "maris_quell",
      "text": "You didn't audition for the room. You listened while I still had a fight. After the toast I publish whether Voss likes it or not. If you want another ninety seconds, find me between fallout meetings \u2014 my calendar, my terms. Not your mission's.",
      "tags": [
        "connection",
        "end",
        "ending",
        "maris_quell"
      ],
      "conditions": [],
      "effects": [
        {
          "op": "set_flag",
          "flag": "chapter_complete",
          "value": true
        },
        {
          "op": "rel",
          "char": "maris_quell",
          "affection": 3
        },
        {
          "op": "rel",
          "char": "maris_quell",
          "trust": 2
        },
        {
          "op": "rel",
          "char": "maris_quell",
          "perceived_authenticity": 10
        },
        {
          "op": "memory",
          "id": "mem_ending_connection",
          "summary": "Maris offered another ninety seconds \u2014 a hypothesis, not a promise.",
          "salience": 7,
          "tags": [
            "ending",
            "maris"
          ]
        },
        {
          "op": "set_flag",
          "flag": "ending_id",
          "value": "connection"
