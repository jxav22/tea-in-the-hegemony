        "location",
        "terrace"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "seen_terrace",
          "value": true
        }
      ],
      "choices": [
        {
          "id": "c_listen",
          "text": "Drift toward the ferns \u2014 Voss is mid-sentence.",
          "intent": "tradecraft",
          "next": "political.hook"
        },
        {
          "id": "c_sac",
          "text": "Something is wrong on the stair \u2014 Taly.",
          "intent": "empathy",
