          "flag": "ending_id",
          "value": "professional_win"
        }
      ],
      "choices": [],
      "next": null,
      "faculty_interjections": [
        {
          "faculty": "Tradecraft",
          "text": "Mission green. Human ledger red. Wren will clap once.",
          "weight": 1
        },
        {
          "faculty": "Idealism",
          "text": "You optimized the wrong variable.",
          "weight": 2
        }
      ]
    },
