              "value": true
            }
          ]
        }
      ],
      "next": null,
      "faculty_interjections": [
        {
          "faculty": "Tradecraft",
          "text": "Toast clock ticking. Soft extract preferred if you value exits.",
          "weight": 1
        },
        {
          "faculty": "Analysis",
          "text": "Folio stamp matches Voss's aide. This is the fragment.",
          "weight": 1
        },
        {
          "faculty": "Insecurity",
          "text": "If you get caught, Wren will invent a new romance protocol as punishment.",
          "weight": 1
        }
      ]
    },
    {
      "id": "study.extract",
