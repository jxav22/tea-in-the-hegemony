      "next": null,
      "faculty_interjections": [
        {
          "faculty": "Improvisation",
          "text": "Do not revive the joke. Let the corpse rest.",
          "weight": 1
        }
      ]
    },
    {
      "id": "salon.genuine_offer",
      "speaker": "maris_quell",
      "text": "Taly's fetching something that claims to be champagne. Ninety seconds. I'm not auditioning a date \u2014 I'm deciding whether Orth is careful, interesting, or both. Use the seconds poorly or well. Curiosity is free; access isn't.",
