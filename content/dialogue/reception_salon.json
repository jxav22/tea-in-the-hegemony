    {
      "id": "salon.enter",
      "speaker": "narrator",
      "text": "The salon is proximity engineered by people who call it chance: policy, money, and guests bored on purpose. Maris Quell stands by the tall window \u2014 not holding court, holding her own briefing in her head. Glass half-full. Expression half-elsewhere, on purpose.",
      "tags": [
        "salon",
        "arrival"
      ],
      "conditions": [],
      "effects": [
        {
          "op": "location",
          "id": "salon"
        }
      ],
      "choices": [
        {
          "id": "salon.enter.approach",
          "text": "Approach Maris before your faculties form a committee.",
          "intent": "direct",
          "next": "salon.intro_awkward",
          "effects": []
        },
        {
          "id": "salon.enter.taly_first",
          "text": "The woman beside her is already measuring you. Address that.",
          "intent": "cautious",
          "next": "salon.taly_intercept",
          "effects": []
        }
      ],
      "next": null,
      "faculty_interjections": [
        {
          "faculty": "Analysis",
          "text": "Window exit, two conversational clusters, one dead zone by the ferns. Ferns are always guilty.",
          "weight": 1
        },
        {
          "faculty": "Insecurity",
          "text": "She has already finished inventorying you. Or the window. Or both.",
          "weight": 1
        }
      ]
    },
    {
      "id": "salon.genuine_deflect",
      "speaker": "maris_quell",
      "text": "Cute armor. Logistics as moral philosophy. Keep the hinges oiled if you need them \u2014 just know I can see where the plate meets the person.",
