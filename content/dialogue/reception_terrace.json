      "next": null,
      "faculty_interjections": [
        {
          "faculty": "Empathy",
          "text": "Hypothesis. Hold it gently.",
          "weight": 1
        },
        {
          "faculty": "Idealism",
          "text": "This is the point. Try not to brief it to death.",
          "weight": 1
        }
      ]
    },
    {
      "id": "ending.cover_burned",
      "speaker": "clerk_moth",
      "text": "Security requests your company. Bring your badge. Leave your metaphors.",
