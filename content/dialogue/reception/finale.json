{
  "id": "reception.finale",
  "chapter_id": "the_reception",
  "nodes": [
    {
      "id": "finale.router",
      "speaker": "narrator",
      "text": "The toast is three minutes out. Choices congeal into an ending.",
      "tags": ["finale", "router"],
      "conditions": [],
      "effects": [{"op": "set_flag", "flag": "finale_started", "value": true}],
      "choices": [
        {
          "id": "finale.route.compute",
          "text": "See what you've made of the evening.",
          "intent": "proceed",
          "next": "finale.branch",
          "effects": []
        }
      ],
      "next": null,
      "faculty_interjections": [
        {"faculty": "Analysis", "text": "Weigh fragment, cover, Maris, heat. Pick the future you can live inside.", "weight": 1}
      ]
    },
    {
      "id": "finale.branch",
      "speaker": "narrator",
      "text": "The room lifts glasses. Somewhere a cipher either sits in your pocket, Sera's, or nowhere useful.",
      "tags": ["finale"],
      "conditions": [],
      "effects": [],
      "choices": [
        {
          "id": "finale.to.professional",
          "text": "[If fragment held, cover stable, low human cost]",
          "intent": "ending",
          "next": "ending.professional_win",
          "effects": [],
          "conditions": [
            {"flag": "has_cipher_fragment", "op": "eq", "value": true},
            {"flag": "cover_compromised", "op": "neq", "value": true},
            {"flag": "abandoned_taly", "op": "eq", "value": true}
          ]
        },
        {
          "id": "finale.to.balanced",
          "text": "[If fragment held and you helped Taly / split]",
          "intent": "ending",
          "next": "ending.balanced",
          "effects": [],
          "conditions": [
            {"flag": "has_cipher_fragment", "op": "eq", "value": true},
            {"flag": "helped_taly", "op": "eq", "value": true}
          ]
        },
        {
          "id": "finale.to.human",
          "text": "[If you helped Taly and lost fragment race]",
          "intent": "ending",
          "next": "ending.human_cost",
          "effects": [],
          "conditions": [
            {"flag": "helped_taly", "op": "eq", "value": true},
            {"flag": "has_cipher_fragment", "op": "neq", "value": true}
          ]
        },
        {
          "id": "finale.to.burned",
          "text": "[If cover compromised]",
          "intent": "ending",
          "next": "ending.cover_burned",
          "effects": [],
          "conditions": [{"flag": "cover_compromised", "op": "eq", "value": true}]
        },
        {
          "id": "finale.to.sera",
          "text": "[If Sera took advantage of delay]",
          "intent": "ending",
          "next": "ending.sera_wins",
          "effects": [],
          "conditions": [
            {"flag": "sera_gained_time", "op": "eq", "value": true},
            {"flag": "fragment_risk", "op": "eq", "value": true}
          ]
        },
        {
          "id": "finale.to.connection",
          "text": "[If genuine with Maris and mission mixed]",
          "intent": "ending",
          "next": "ending.connection",
          "effects": [],
          "conditions": [
            {"flag": "genuine_with_maris", "op": "eq", "value": true},
            {"flag": "skipped_impress", "op": "eq", "value": true}
          ]
        }
      ],
      "next": "ending.default_mixed",
      "faculty_interjections": [
        {"faculty": "Improvisation", "text": "Engine resolves priority: burned > sera race > balanced > professional > human > connection > mixed.", "weight": 1}
      ]
    },
    {
      "id": "ending.professional_win",
      "speaker": "narrator",
      "text": "You have the fragment. Cover holds. The toast tastes like victory and something metallic. Across the room Maris does not look at you — or looks once, files you under solved, and turns away.",
      "tags": ["ending", "professional"],
      "conditions": [],
      "effects": [
        {"op": "set_flag", "flag": "ending_id", "value": "professional_win"},
        {"op": "set_flag", "flag": "chapter_complete", "value": true}
      ],
      "choices": [
        {
          "id": "ending.professional.debrief",
          "text": "Leave for debrief.",
          "intent": "exit",
          "next": "debrief.intro",
          "effects": []
        }
      ],
      "next": null,
      "faculty_interjections": [
        {"faculty": "Tradecraft", "text": "Mission green. Human ledger red. Wren will clap once.", "weight": 1},
        {"faculty": "Idealism", "text": "You optimized the wrong variable.", "weight": 2}
      ]
    },
    {
      "id": "ending.balanced",
      "speaker": "narrator",
      "text": "Fragment secured. Taly still has a career. Maris finds you after the toast, dry as ever: 'You managed both kinds of logistics. Don't get addicted.' It isn't praise. It might be a beginning.",
      "tags": ["ending", "balanced"],
      "conditions": [],
      "effects": [
        {"op": "set_flag", "flag": "ending_id", "value": "balanced"},
        {"op": "set_flag", "flag": "chapter_complete", "value": true},
        {"op": "rel", "char": "maris_quell", "familiarity": 2}
      ],
      "choices": [
        {
          "id": "ending.balanced.debrief",
          "text": "Leave for debrief.",
          "intent": "exit",
          "next": "debrief.intro",
          "effects": []
        }
      ],
      "next": null,
      "faculty_interjections": [
        {"faculty": "Empathy", "text": "Both ledgers breathing. Rare night.", "weight": 1},
        {"faculty": "Composure", "text": "Accept almost-praise without inventing a wedding.", "weight": 1}
      ]
    },
    {
      "id": "ending.human_cost",
      "speaker": "sera_kade",
      "text": "Cute rescue. I took the annex while you took the moral high ground. Don't worry — I'll send Wren a postcard.",
      "tags": ["ending", "human_cost", "sera_kade"],
      "conditions": [],
      "effects": [
        {"op": "set_flag", "flag": "ending_id", "value": "human_cost"},
        {"op": "set_flag", "flag": "has_cipher_fragment", "value": false},
        {"op": "set_flag", "flag": "sera_has_fragment", "value": true},
        {"op": "set_flag", "flag": "chapter_complete", "value": true},
        {"op": "rel", "char": "maris_quell", "trust": 2},
        {"op": "rel", "char": "maris_quell", "affection": 2}
      ],
      "choices": [],
      "next": "ending.human_cost_maris",
      "faculty_interjections": [
        {"faculty": "Tradecraft", "text": "Fragment lost. Rival scored. Anticipate Wren's clinical disappointment.", "weight": 1}
      ]
    },
    {
      "id": "ending.human_cost_maris",
      "speaker": "maris_quell",
      "text": "Taly told me. You chose a person over a win. I don't know what you came here for — but I know what you did. That's data I'll keep.",
      "tags": ["ending", "maris_quell"],
      "conditions": [],
      "effects": [
        {"op": "add_memory", "id": "mem_ending_human", "summary": "Lost the fragment to Sera; gained Maris's measured respect.", "salience": 7, "tags": ["ending", "maris"], "created_at_beat": "finale"}
      ],
      "choices": [
        {
          "id": "ending.human.debrief",
          "text": "Leave for debrief.",
          "intent": "exit",
          "next": "debrief.intro",
          "effects": []
        }
      ],
      "next": null,
      "faculty_interjections": [
        {"faculty": "Idealism", "text": "Data she'll keep. That's more than a mission stamp.", "weight": 1},
        {"faculty": "Insecurity", "text": "Wren will not keep that data warmly.", "weight": 1}
      ]
    },
    {
      "id": "ending.cover_burned",
      "speaker": "clerk_moth",
      "text": "Security requests your company. Bring your badge. Leave your metaphors.",
      "tags": ["ending", "burned", "comedy"],
      "conditions": [],
      "effects": [
        {"op": "set_flag", "flag": "ending_id", "value": "cover_burned"},
        {"op": "set_flag", "flag": "chapter_complete", "value": true},
        {"op": "set_flag", "flag": "extracted_hot", "value": true}
      ],
      "choices": [
        {
          "id": "ending.burned.debrief",
          "text": "Extract hot. Debrief awaits.",
          "intent": "exit",
          "next": "debrief.intro",
          "effects": []
        }
      ],
      "next": null,
      "faculty_interjections": [
        {"faculty": "Tradecraft", "text": "Burned is recoverable. Pride is optional cargo.", "weight": 1},
        {"faculty": "Composure", "text": "Walk. Do not run. Running confirms ink.", "weight": 1}
      ]
    },
    {
      "id": "ending.sera_wins",
      "speaker": "sera_kade",
      "text": "You were busy being good. I was busy being finished. Smile with the lower third for your handler — she'll need the practice.",
      "tags": ["ending", "sera_wins"],
      "conditions": [],
      "effects": [
        {"op": "set_flag", "flag": "ending_id", "value": "sera_wins"},
        {"op": "set_flag", "flag": "has_cipher_fragment", "value": false},
        {"op": "set_flag", "flag": "sera_has_fragment", "value": true},
        {"op": "set_flag", "flag": "chapter_complete", "value": true}
      ],
      "choices": [
        {
          "id": "ending.sera.debrief",
          "text": "Leave for debrief.",
          "intent": "exit",
          "next": "debrief.intro",
          "effects": []
        }
      ],
      "next": null,
      "faculty_interjections": [
        {"faculty": "Analysis", "text": "Delay cost the race. Help was real; so was the invoice.", "weight": 1}
      ]
    },
    {
      "id": "ending.connection",
      "speaker": "maris_quell",
      "text": "You didn't perform for the room. You talked to me. Whatever else you came for — and I suspect there is an else — I'd take another ninety seconds sometime. Not a promise. A hypothesis.",
      "tags": ["ending", "connection", "maris_quell"],
      "conditions": [],
      "effects": [
        {"op": "set_flag", "flag": "ending_id", "value": "connection"},
        {"op": "set_flag", "flag": "chapter_complete", "value": true},
        {"op": "rel", "char": "maris_quell", "affection": 3},
        {"op": "rel", "char": "maris_quell", "trust": 2},
        {"op": "rel", "char": "maris_quell", "perceived_authenticity": 10},
        {"op": "add_memory", "id": "mem_ending_connection", "summary": "Maris offered another ninety seconds — a hypothesis, not a promise.", "salience": 7, "tags": ["ending", "maris"], "created_at_beat": "finale"}
      ],
      "choices": [
        {
          "id": "ending.connection.debrief",
          "text": "Leave for debrief.",
          "intent": "exit",
          "next": "debrief.intro",
          "effects": []
        }
      ],
      "next": null,
      "faculty_interjections": [
        {"faculty": "Empathy", "text": "Hypothesis. Hold it gently.", "weight": 1},
        {"faculty": "Idealism", "text": "This is the point. Try not to brief it to death.", "weight": 1}
      ]
    },
    {
      "id": "ending.default_mixed",
      "speaker": "narrator",
      "text": "The evening ends in mixed weather: some intel, some bruises, some looks you can't classify. You leave with enough to justify a debrief and not enough to justify pride.",
      "tags": ["ending", "mixed"],
      "conditions": [],
      "effects": [
        {"op": "set_flag", "flag": "ending_id", "value": "mixed"},
        {"op": "set_flag", "flag": "chapter_complete", "value": true}
      ],
      "choices": [
        {
          "id": "ending.mixed.debrief",
          "text": "Leave for debrief.",
          "intent": "exit",
          "next": "debrief.intro",
          "effects": []
        }
      ],
      "next": null,
      "faculty_interjections": [
        {"faculty": "Analysis", "text": "Mixed is the median spy ending. Honest, if unflattering.", "weight": 1}
      ]
    }
  ]
}
