{
  "id": "reception_foyer",
  "start": "foyer.arrival",
  "nodes": [
    {
      "id": "foyer.arrival",
      "speaker": "narrator",
      "text": "Voss House foyer: marble that remembers better shoes than yours, a string quartet losing a polite argument with champagne laughter, guests practicing their own names like cover identities.",
      "tags": [
        "foyer",
        "arrival"
      ],
      "conditions": [
        {
          "flag": "briefed",
          "op": "eq",
          "value": true
        }
      ],
      "effects": [
        {
          "op": "location",
          "id": "foyer"
        }
      ],
      "choices": [
        {
          "id": "foyer.arrival.badge",
          "text": "Present the Orth badge like it has always existed.",
          "intent": "professional",
          "next": "foyer.moth_check",
          "effects": []
        },
        {
          "id": "foyer.arrival.scan",
          "text": "Scan exits, cameras, and who is watching the watchers.",
          "intent": "tradecraft",
          "next": "foyer.moth_check",
          "effects": [
            {
              "op": "set_flag",
              "flag": "foyer_scanned",
              "value": true
            },
            {
              "op": "rel",
              "char": "sera_kade",
              "suspicion": 1
            }
          ]
        }
      ],
      "next": null,
      "faculty_interjections": [
        {
          "faculty": "Tradecraft",
          "text": "Two cameras, one blind corner by the cloakroom. Noted.",
          "weight": 1
        },
        {
          "faculty": "Insecurity",
          "text": "Your invitation is real. Your face is still auditioning.",
          "weight": 1
        },
        {
          "faculty": "Composure",
          "text": "Breathe as if freight margins soothe you. Belonging is mostly posture.",
          "weight": 1
        }
      ]
    },
    {
      "id": "foyer.moth_check",
      "speaker": "clerk_moth",
      "text": "Badge. Invitation. Full legal name as printed \u2014 not as hoped. Discrepancies will be logged, escalated, and, if necessary, laminated.",
      "tags": [
        "foyer",
        "clerk_moth"
      ],
      "conditions": [],
      "effects": [],
      "choices": [
        {
          "id": "foyer.moth.orth",
          "text": "Cassian Orth. Ministry Trade Liaison. Logistics.",
          "intent": "comply",
          "next": "foyer.moth_pass",
          "effects": [
            {
              "op": "rel",
              "char": "clerk_moth",
              "respect": 1
            }
          ]
        },
        {
          "id": "foyer.moth.joke",
          "text": "I left my other name with the coat check.",
          "intent": "joke",
          "next": "foyer.moth_sideeye",
          "effects": [
            {
              "op": "rel",
              "char": "clerk_moth",
              "suspicion": 2
            },
            {
              "op": "set_flag",
              "flag": "moth_annoyed",
              "value": true
            }
          ]
        }
      ],
      "next": null,
      "faculty_interjections": [
        {
          "faculty": "Improvisation",
          "text": "Do not joke. This human laminates joy.",
          "weight": 2
        },
        {
          "faculty": "Analysis",
          "text": "Procedural zealot. Compliance is camouflage.",
          "weight": 1
        }
      ]
    },
    {
      "id": "foyer.moth_pass",
      "speaker": "clerk_moth",
      "text": "Orth. Matches. Proceed. Do not rearrange the seating cards. They are not suggestions.",
      "tags": [
        "foyer"
      ],
      "conditions": [],
      "effects": [
        {
          "op": "set_flag",
          "flag": "entered_reception",
          "value": true
        }
      ],
      "choices": [
        {
          "id": "foyer.pass.salon",
          "text": "Salon. Voices. Opportunity.",
          "intent": "explore",
          "next": null,
          "effects": [
            {
              "op": "location",
              "id": "salon"
            },
            {
              "op": "location",
              "id": "salon"
            },
            {
              "op": "set_flag",
              "flag": "resume_salon_enter",
              "value": true
            }
          ]
        },
        {
          "id": "foyer.pass.pim",
          "text": "Someone is waving with both arms. That is either rescue or Pim.",
          "intent": "social",
          "next": "foyer.pim",
          "effects": []
        }
      ],
      "next": null,
      "faculty_interjections": [
        {
          "faculty": "Tradecraft",
          "text": "You're in. Clock starts now.",
          "weight": 1
        }
      ]
    },
    {
      "id": "foyer.moth_sideeye",
      "speaker": "clerk_moth",
      "text": "Coat check is a separate jurisdiction. Your joke has been noted in pencil. Pencil can become ink.",
      "tags": [
        "foyer",
        "comedy"
      ],
      "conditions": [],
      "effects": [],
      "choices": [
        {
          "id": "foyer.moth_sideeye.recover",
          "text": "Cassian Orth. As printed. Apologies for the pencil.",
          "intent": "recover",
          "next": "foyer.moth_pass",
          "effects": [
            {
              "op": "rel",
              "char": "clerk_moth",
              "suspicion": -1
            }
          ]
        }
      ],
      "next": null,
      "faculty_interjections": [
        {
          "faculty": "Composure",
          "text": "Apologize like a spreadsheet. He respects boredom.",
          "weight": 1
        }
      ]
    },
    {
      "id": "foyer.pim",
      "speaker": "pim_orel",
      "text": "Orth! You look like draft seventeen of a first sentence. Come \u2014 Maris is in the salon counting arrivals while pretending not to. She's already counted you.",
      "tags": [
        "foyer",
        "pim_orel"
      ],
      "conditions": [],
      "effects": [
        {
          "op": "rel",
          "char": "pim_orel",
          "familiarity": 2
        },
        {
          "op": "set_flag",
          "flag": "saw_pim",
          "value": true
        }
      ],
      "choices": [
        {
          "id": "foyer.pim.go",
          "text": "Lead. Before I invent draft eighteen.",
          "intent": "accept",
          "next": null,
          "effects": [
            {
              "op": "set_flag",
              "flag": "pim_escort",
              "value": true
            },
            {
              "op": "location",
              "id": "salon"
            }
          ]
        },
        {
          "id": "foyer.pim.delay",
          "text": "Thirty seconds. Then salon.",
          "intent": "stall",
          "next": null,
          "effects": [
            {
              "op": "rel",
              "char": "pim_orel",
              "comfort": 1
            },
            {
              "op": "location",
              "id": "salon"
            }
          ]
        }
      ],
      "next": null,
      "faculty_interjections": [
        {
          "faculty": "Insecurity",
          "text": "Seventeen is low. Be honest.",
          "weight": 1
        },
        {
          "faculty": "Empathy",
          "text": "Pim is loud and somehow kind. Do not use him as furniture.",
          "weight": 1
        }
      ]
    }
  ]
}
