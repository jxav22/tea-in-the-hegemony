{
  "id": "debrief",
  "start": "debrief.intro",
  "nodes": [
    {
      "id": "debrief.intro",
      "speaker": "wren_halden",
      "text": "Sit. Same chair. Professional outcomes first. Interpersonal second. I will not let you smuggle one into the other.",
      "tags": [
        "debrief",
        "entry"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_started",
          "value": true
        }
      ],
      "faculty_interjections": [
        {
          "faculty": "Insecurity",
          "text": "She already knows. This is theatre with a grade.",
          "weight": 1
        },
        {
          "faculty": "Composure",
          "text": "Facts first. Feelings filed as facts.",
          "weight": 1
        }
      ],
      "choices": [
        {
          "id": "debrief.route",
          "text": "Begin.",
          "intent": "proceed",
          "next": "debrief.router"
        }
      ]
    },
    {
      "id": "debrief.router",
      "speaker": "narrator",
      "text": "She finds your evening in the notes without asking.",
      "tags": [
        "debrief",
        "router"
      ],
      "choices": [
        {
          "id": "r_burned",
          "text": "[Cover burned]",
          "intent": "system",
          "next": "debrief.ending_burned",
          "conditions": [
            {
              "flag": "ending_id",
              "op": "eq",
              "value": "cover_burned"
            }
          ]
        },
        {
          "id": "r_sera",
          "text": "[Sera took the fragment]",
          "intent": "system",
          "next": "debrief.ending_sera",
          "conditions": [
            {
              "any": [
                {
                  "flag": "ending_id",
                  "op": "eq",
                  "value": "sera_wins"
                },
                {
                  "all": [
                    {
                      "flag": "sera_has_fragment",
                      "op": "eq",
                      "value": true
                    },
                    {
                      "flag": "got_fragment",
                      "op": "neq",
                      "value": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "r_balanced",
          "text": "[Fragment + helped Taly]",
          "intent": "system",
          "next": "debrief.ending_balanced",
          "conditions": [
            {
              "any": [
                {
                  "flag": "ending_id",
                  "op": "eq",
                  "value": "balanced"
                },
                {
                  "all": [
                    {
                      "flag": "got_fragment",
                      "op": "eq",
                      "value": true
                    },
                    {
                      "flag": "helped_taly",
                      "op": "eq",
                      "value": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "r_pro",
          "text": "[Cold professional win]",
          "intent": "system",
          "next": "debrief.ending_professional",
          "conditions": [
            {
              "any": [
                {
                  "flag": "ending_id",
                  "op": "eq",
                  "value": "professional_win"
                },
                {
                  "all": [
                    {
                      "flag": "got_fragment",
                      "op": "eq",
                      "value": true
                    },
                    {
                      "flag": "abandoned_taly",
                      "op": "eq",
                      "value": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "r_human",
          "text": "[Human cost]",
          "intent": "system",
          "next": "debrief.ending_human",
          "conditions": [
            {
              "any": [
                {
                  "flag": "ending_id",
                  "op": "eq",
                  "value": "human_cost"
                },
                {
                  "all": [
                    {
                      "flag": "helped_taly",
                      "op": "eq",
                      "value": true
                    },
                    {
                      "flag": "got_fragment",
                      "op": "neq",
                      "value": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "r_connection",
          "text": "[Connection]",
          "intent": "system",
          "next": "debrief.ending_connection",
          "conditions": [
            {
              "any": [
                {
                  "flag": "ending_id",
                  "op": "eq",
                  "value": "connection"
                },
                {
                  "all": [
                    {
                      "flag": "genuine_with_maris",
                      "op": "eq",
                      "value": true
                    },
                    {
                      "flag": "skipped_impress",
                      "op": "eq",
                      "value": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "r_mixed",
          "text": "[Mixed]",
          "intent": "system",
          "next": "debrief.ending_mixed"
        }
      ],
      "next": "debrief.ending_mixed",
      "faculty_interjections": [
        {
          "faculty": "Analysis",
          "text": "Match flags to the least flattering true ending.",
          "weight": 1
        }
      ]
    },
    {
      "id": "debrief.ending_burned",
      "speaker": "wren_halden",
      "text": "Operational: Orth is burned. Moth inked the serial. We retire the badge or bleach it; either way the annex is watched and Friday's dock window just got expensive. You handed a procedural zealot a purpose. Never do that.",
      "tags": [
        "debrief",
        "cover_burned"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_prof_grade",
          "value": "burned"
        },
        {
          "op": "set_flag",
          "flag": "ending_id",
          "value": "cover_burned"
        }
      ],
      "choices": [
        {
          "id": "burned.inter",
          "text": "And the interpersonal column?",
          "intent": "proceed",
          "next": "debrief.ending_burned_inter"
        }
      ],
      "faculty_interjections": [
        {
          "faculty": "Tradecraft",
          "text": "Burned is recoverable. Pride is optional cargo.",
          "weight": 1
        }
      ]
    },
    {
      "id": "debrief.ending_burned_inter",
      "speaker": "wren_halden",
      "text": "Interpersonal: Maris watched a liaison become a security incident. She will finish that risk assessment without you \u2014 Observatory does not invite liabilities to opacity fights. Taly will tell it as farce. You are both punchline and problem.",
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_inter_grade",
          "value": "liability"
        }
      ],
      "next": "debrief.close_burned"
    },
    {
      "id": "debrief.close_burned",
      "speaker": "wren_halden",
      "text": "Dismissed. If you see Maris, do not explain. Explanations travel. Leave before Security practices its smile.",
      "tags": [
        "debrief",
        "ending",
        "end"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "reception_debrief_complete",
          "value": true
        },
        {
          "op": "set_flag",
          "flag": "chapter_the_reception_done",
          "value": true
        }
      ],
      "choices": [],
      "next": null
    },
    {
      "id": "debrief.ending_sera",
      "speaker": "wren_halden",
      "text": "Operational: Sera has the cipher. East-dock revision before the toast is her annotation now. We are late to a window we named first. She will be unbearable in the precise way that wins.",
      "tags": [
        "debrief",
        "sera_wins"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_prof_grade",
          "value": "lost_race"
        },
        {
          "op": "set_flag",
          "flag": "ending_id",
          "value": "sera_wins"
        }
      ],
      "choices": [
        {
          "id": "sera.inter",
          "text": "Interpersonal.",
          "intent": "proceed",
          "next": "debrief.ending_sera_inter"
        }
      ],
      "faculty_interjections": [
        {
          "faculty": "Analysis",
          "text": "Delay invoice paid in cipher.",
          "weight": 1
        }
      ]
    },
    {
      "id": "debrief.ending_sera_inter",
      "speaker": "wren_halden",
      "text": "Interpersonal: you spent the minute on Taly; she spent it on the folio. Maris can respect the choice and still rank outcomes above manners \u2014 she publishes schedules, not eulogies. Do not mistake her scorekeeping for attachment.",
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_inter_grade",
          "value": "decent_last"
        }
      ],
      "next": "debrief.close_sera"
    },
    {
      "id": "debrief.close_sera",
      "speaker": "wren_halden",
      "text": "Next time be decent and finished, or admit you ranked them. Dismissed. Sera's postcard will arrive first.",
      "tags": [
        "debrief",
        "ending",
        "end"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "reception_debrief_complete",
          "value": true
        },
        {
          "op": "set_flag",
          "flag": "chapter_the_reception_done",
          "value": true
        }
      ],
      "next": null
    },
    {
      "id": "debrief.ending_balanced",
      "speaker": "wren_halden",
      "text": "Operational: fragment secured, cover held, Voss's Friday window is spoilable. Analysts employed; Sera annoyed. That is the correct weather.",
      "tags": [
        "debrief",
        "balanced"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_prof_grade",
          "value": "good"
        },
        {
          "op": "set_flag",
          "flag": "ending_id",
          "value": "balanced"
        }
      ],
      "choices": [
        {
          "id": "bal.inter",
          "text": "Interpersonal.",
          "intent": "proceed",
          "next": "debrief.ending_balanced_inter"
        }
      ]
    },
    {
      "id": "debrief.ending_balanced_inter",
      "speaker": "wren_halden",
      "text": "Interpersonal: Taly keeps a career because you spent mission-shaped minutes on a person. Maris clocked the split \u2014 not as romance, as someone who can hold a dock fight and a friend without dumping either. She may grant a second conversation. She does not owe you warmth for competence.",
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_inter_grade",
          "value": "partner_shaped"
        },
        {
          "op": "rel",
          "char": "wren_halden",
          "respect": 1
        }
      ],
      "faculty_interjections": [
        {
          "faculty": "Idealism",
          "text": "Partner-shaped. Frame it. Don't wedding it.",
          "weight": 1
        }
      ],
      "next": "debrief.close_balanced"
    },
    {
      "id": "debrief.close_balanced",
      "speaker": "wren_halden",
      "text": "If Maris contacts you, report contact \u2014 channel hygiene, not courtship. Go. Leave pride in the chair.",
      "tags": [
        "debrief",
        "ending",
        "end"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "reception_debrief_complete",
          "value": true
        },
        {
          "op": "set_flag",
          "flag": "chapter_the_reception_done",
          "value": true
        }
      ],
      "next": null
    },
    {
      "id": "debrief.ending_professional",
      "speaker": "wren_halden",
      "text": "Operational: green across the board. Fragment. Cover. Voss timed to the toast. I could almost congratulate you. I will inventory you instead.",
      "tags": [
        "debrief",
        "professional_win"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_prof_grade",
          "value": "excellent"
        },
        {
          "op": "set_flag",
          "flag": "ending_id",
          "value": "professional_win"
        }
      ],
      "choices": [
        {
          "id": "pro.inter",
          "text": "Interpersonal.",
          "intent": "proceed",
          "next": "debrief.ending_professional_inter"
        }
      ]
    },
    {
      "id": "debrief.ending_professional_inter",
      "speaker": "wren_halden",
      "text": "Interpersonal: you passed Taly like weather with a badge. By morning Maris will have you filed under optimized noise \u2014 a man who cleared objectives and treated people as latency. That is her door closing, not a failed flirtation. Mission loved you. The room did not.",
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_inter_grade",
          "value": "cold"
        },
        {
          "op": "rel",
          "char": "wren_halden",
          "respect": -1
        }
      ],
      "faculty_interjections": [
        {
          "faculty": "Idealism",
          "text": "You optimized the wrong variable.",
          "weight": 2
        }
      ],
      "next": "debrief.close_professional"
    },
    {
      "id": "debrief.close_professional",
      "speaker": "wren_halden",
      "text": "Keep the fragment. Stop calling humans downstream. Dismissed before I invent smiling homework.",
      "tags": [
        "debrief",
        "ending",
        "end"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "reception_debrief_complete",
          "value": true
        },
        {
          "op": "set_flag",
          "flag": "chapter_the_reception_done",
          "value": true
        }
      ],
      "next": null
    },
    {
      "id": "debrief.ending_human",
      "speaker": "wren_halden",
      "text": "Operational: empty pocket. Sera holds the cipher; the dock window is hers to open and ours to chase. Failure with a receipt \u2014 moral department signed, logistics stamped late.",
      "tags": [
        "debrief",
        "human_cost"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_prof_grade",
          "value": "poor"
        },
        {
          "op": "set_flag",
          "flag": "ending_id",
          "value": "human_cost"
        }
      ],
      "choices": [
        {
          "id": "human.inter",
          "text": "Interpersonal.",
          "intent": "proceed",
          "next": "debrief.ending_human_inter"
        }
      ]
    },
    {
      "id": "debrief.ending_human_inter",
      "speaker": "wren_halden",
      "text": "Interpersonal: Maris kept what you did for Taly as evidence about pressure behavior \u2014 Observatory habit, personal habit. She may never enjoy you. She may still prefer you to collectors. Logged decent. Operationally irritating. Warn me next time.",
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_inter_grade",
          "value": "decent"
        },
        {
          "op": "rel",
          "char": "wren_halden",
          "trust": 1,
          "affection": 1
        }
      ],
      "next": "debrief.close_human"
    },
    {
      "id": "debrief.close_human",
      "speaker": "wren_halden",
      "text": "We work Sera's gap. Do not apologize for the person you saved; apologize for the minute if you must. Dismissed.",
      "tags": [
        "debrief",
        "ending",
        "end"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "reception_debrief_complete",
          "value": true
        },
        {
          "op": "set_flag",
          "flag": "chapter_the_reception_done",
          "value": true
        }
      ],
      "next": null
    },
    {
      "id": "debrief.ending_connection",
      "speaker": "wren_halden",
      "text": "Operational: uneven. Restraint cost spectacle; cover likely held. Fragment depends on what your hands actually took while you were busy not auditioning for Voss's shelf.",
      "tags": [
        "debrief",
        "connection"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_prof_grade",
          "value": "uneven"
        },
        {
          "op": "set_flag",
          "flag": "ending_id",
          "value": "connection"
        }
      ],
      "choices": [
        {
          "id": "conn.inter",
          "text": "Interpersonal.",
          "intent": "proceed",
          "next": "debrief.ending_connection_inter"
        }
      ]
    },
    {
      "id": "debrief.ending_connection_inter",
      "speaker": "wren_halden",
      "text": "Interpersonal: she offered ninety seconds between fallout meetings \u2014 calendar scraps from a woman about to publish against Voss, not a unlock. You treated her opacity fight as real. That is rare. Do not spend it on performance.",
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_inter_grade",
          "value": "human_shaped"
        },
        {
          "op": "rel",
          "char": "wren_halden",
          "respect": 1
        }
      ],
      "faculty_interjections": [
        {
          "faculty": "Empathy",
          "text": "Hypothesis. Hold it gently.",
          "weight": 1
        }
      ],
      "next": "debrief.close_connection"
    },
    {
      "id": "debrief.close_connection",
      "speaker": "wren_halden",
      "text": "If she messages, you tell me \u2014 secrets travel. Keep the minutes where you were a person. Dismissed.",
      "tags": [
        "debrief",
        "ending",
        "end"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "reception_debrief_complete",
          "value": true
        },
        {
          "op": "set_flag",
          "flag": "chapter_the_reception_done",
          "value": true
        }
      ],
      "next": null
    },
    {
      "id": "debrief.ending_mixed",
      "speaker": "wren_halden",
      "text": "Operational: mixed. Heat, hints, half-wins. Enough for a report. Not enough for a myth. I've seen worse from men who smile with their whole face.",
      "tags": [
        "debrief",
        "mixed"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_prof_grade",
          "value": "mixed"
        },
        {
          "op": "set_flag",
          "flag": "ending_id",
          "value": "mixed"
        }
      ],
      "choices": [
        {
          "id": "mixed.inter",
          "text": "Interpersonal.",
          "intent": "proceed",
          "next": "debrief.ending_mixed_inter"
        }
      ]
    },
    {
      "id": "debrief.ending_mixed_inter",
      "speaker": "wren_halden",
      "text": "Interpersonal: awkward, occasionally real, frequently wrong. Maris has incomplete data \u2014 unfinished assessment, not romance. She has not decided. Neither should you congratulate yourself.",
      "effects": [
        {
          "op": "set_flag",
          "flag": "debrief_inter_grade",
          "value": "incomplete"
        }
      ],
      "next": "debrief.close_mixed"
    },
    {
      "id": "debrief.close_mixed",
      "speaker": "wren_halden",
      "text": "Orth remains useful until he doesn't. Finish a ledger next time \u2014 or both, if you insist on difficulty. Dismissed.",
      "tags": [
        "debrief",
        "ending",
        "end"
      ],
      "effects": [
        {
          "op": "set_flag",
          "flag": "reception_debrief_complete",
          "value": true
        },
        {
          "op": "set_flag",
          "flag": "chapter_the_reception_done",
          "value": true
        }
      ],
      "next": null
    }
  ]
}
